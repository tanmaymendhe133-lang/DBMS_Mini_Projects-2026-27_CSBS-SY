import mysql.connector

# Connect Python to MySQL
db = mysql.connector.connect(
    host="localhost",
    user="root",
    password="YOUR_MYSQL_PASSWORD",
    database="StudentManagement"
)

cursor = db.cursor()

# Add Student
def add_student():
    print("\n--- Add Student ---")

    name = input("Enter Name: ")
    roll = input("Enter Roll Number: ")
    email = input("Enter Email: ")
    phone = input("Enter Phone: ")
    department = input("Enter Department: ")
    semester = int(input("Enter Semester: "))

    sql = """INSERT INTO Students
    (name, roll_no, email, phone, department, semester)
    VALUES (%s, %s, %s, %s, %s, %s)"""

    values = (name, roll, email, phone, department, semester)

    try:
        cursor.execute(sql, values)
        db.commit()
        print("Student Added Successfully!")
    except mysql.connector.Error as err:
        db.rollback()
        print("Error:", err)


# View All Students
def view_students():
    print("\n--- Student Records ---")

    cursor.execute("SELECT * FROM Students")
    records = cursor.fetchall()

    for student in records:
        print(student)


# Search Student
def search_student():
    roll = input("Enter Roll Number: ")

    cursor.execute(
        "SELECT * FROM Students WHERE roll_no = %s",
        (roll,)
    )

    result = cursor.fetchone()

    if result:
        print("Student Found:", result)
    else:
        print("Student Not Found!")


# Update Student
def update_student():
    roll = input("Enter Roll Number: ")
    phone = input("Enter New Phone Number: ")

    cursor.execute(
        "UPDATE Students SET phone = %s WHERE roll_no = %s",
        (phone, roll)
    )

    db.commit()

    if cursor.rowcount > 0:
        print("Student Updated Successfully!")
    else:
        print("Student Not Found!")


# Delete Student
def delete_student():
    roll = input("Enter Roll Number: ")

    cursor.execute(
        "DELETE FROM Students WHERE roll_no = %s",
        (roll,)
    )

    db.commit()

    if cursor.rowcount > 0:
        print("Student Deleted Successfully!")
    else:
        print("Student Not Found!")


# Main Menu
while True:

